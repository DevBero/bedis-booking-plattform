# AWS profile for CDK and deploy scripts (aws login --profile <profil>, see docs/HOSTING.md Schritt 1)
AWS_PROFILE=beyou

# Public base URL of the site (canonical URLs, JSON-LD)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# "true" answers /api/* in the browser with sample data (pnpm dev:mock), no AWS needed
NEXT_PUBLIC_API_MOCK=

# Sanity, only for scripts/seed.mjs (initial content). Token with Editor rights, never commit it
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_TOKEN=
