{
  "name": "bedi-booking",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:mock": "NEXT_PUBLIC_API_MOCK=true next dev",
    "build": "next build",
    "start": "npx serve out",
    "lint": "eslint",
    "typecheck": "tsc --noEmit && pnpm --filter bedi-studio typecheck",
    "test": "tsx --test \"infra/lambda/api/*.test.ts\"",
    "studio": "pnpm --filter bedi-studio dev",
    "studio:build": "pnpm --filter bedi-studio build",
    "synth": "dotenv -- cdk synth -c env=staging",
    "diff:staging": "dotenv -- cdk diff -c env=staging",
    "diff:production": "dotenv -- cdk diff -c env=production",
    "deploy:staging": "dotenv -- cdk deploy -c env=staging --all",
    "deploy:production": "dotenv -- cdk deploy -c env=production --all",
    "deploy:site:staging": "dotenv -- bash scripts/deploy-site.sh staging",
    "deploy:site:production": "dotenv -- bash scripts/deploy-site.sh production",
    "bootstrap": "dotenv -- cdk bootstrap -c env=staging",
    "secret": "dotenv -- node scripts/set-secret.mjs",
    "seed": "node --env-file-if-exists=.env scripts/seed.mjs",
    "qr": "node scripts/qr.mjs",
    "budget": "dotenv -- bash scripts/budget.sh",
    "site-check": "node scripts/site-check.mjs"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.52.0",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "3.1148.0",
    "@aws-sdk/client-sesv2": "3.1148.0",
    "@aws-sdk/client-ssm": "3.1148.0",
    "@tailwindcss/postcss": "^4",
    "@types/aws-lambda": "8.10.164",
    "@types/node": "^22",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "aws-cdk": "^2.1144.0",
    "aws-cdk-lib": "^2.272.0",
    "constructs": "^10.8.1",
    "dotenv-cli": "^11.0.0",
    "esbuild": "0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "pdf-lib": "^1.17.1",
    "playwright": "1.64.0",
    "qrcode": "^1.5.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "packageManager": "pnpm@11.5.3",
  "engines": {
    "node": ">=22"
  }
}
